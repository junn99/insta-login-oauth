# Instagram App Credentials
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# OAuth Configuration
OAUTH_REDIRECT_URI=https://insta-app.streamlit.app/Login
CONTACT_EMAIL=your_contact_email
SESSION_COOKIE_SECRET=replace_with_at_least_32_random_bytes

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_secret_key

# Vercel Preview safety controls
# Use fake refs here only. Set real project refs in Vercel/Supabase environments.
SUPABASE_PREVIEW_PROJECT_REF=your_preview_project_ref
SUPABASE_PRODUCTION_PROJECT_REF=your_production_project_ref
ALLOW_SHARED_SUPABASE_IN_PREVIEW=false
PREVIEW_SAFE_MODE=true
